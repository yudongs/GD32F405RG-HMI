{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gec6100d.local/vtfp.schema.json",
  "title": "VTFP v1 Project Configuration",
  "description": "Schema for project-level vtfp.yaml that drives VTFP code generation.",
  "type": "object",
  "required": ["project", "protocol", "memory", "commands"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "product_id"],
      "additionalProperties": false,
      "properties": {
        "name":         { "type": "string", "minLength": 1 },
        "product_id":   { "type": "string", "pattern": "^[A-Za-z0-9._-]+-[0-9]+\\.[0-9]+$" },
        "model_code":   { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version":       { "const": "0.1.0" },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["lcd_capture", "rtt_log", "ota_hook"]
          },
          "uniqueItems": true
        }
      }
    },
    "memory": {
      "type": "object",
      "required": ["header_base", "data_buffer_size"],
      "additionalProperties": false,
      "properties": {
        "header_base":       { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
        "data_buffer_size":  { "type": "integer", "minimum": 64, "maximum": 65536 },
        "alignment":         { "type": "integer", "enum": [1, 2, 4, 8] }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arm_timeout_ms":  { "type": "integer", "minimum": 100, "maximum": 60000 },
        "safety_key":      { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
        "auto_disarm":     { "type": "boolean" }
      }
    },
    "rtos": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type":        { "type": "string", "enum": ["rt-thread", "freertos", "bare"] },
        "tick_ms":     { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "direction", "requires_arm"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,31}$"
          },
          "description": { "type": "string" },
          "direction": {
            "type": "string",
            "enum": ["pc_to_mcu", "mcu_to_pc"]
          },
          "requires_arm": { "type": "boolean" },
          "request_schema":  { "$ref": "#/definitions/dataSchema" },
          "response_schema": { "$ref": "#/definitions/dataSchema" }
        }
      }
    }
  },
  "definitions": {
    "dataSchema": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["empty", "int", "uint", "string", "bytes", "struct"]
        },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
              "type": { "type": "string", "enum": ["u8", "u16", "u32", "i8", "i16", "i32", "string", "bytes"] },
              "size_bytes": { "type": "integer", "minimum": 1, "maximum": 256 }
            }
          }
        }
      }
    }
  }
}
